# Examples only. Keep credentials outside the repository. Never commit .env.
# For local API auth, run `make api-key-init`. Compose mounts the external file.
# Override its PATH (not the key) with TRENDPILOT_API_KEY_FILE=/absolute/external/path.

# Optional: PostgreSQL prediction-history logging.
# Any SQLAlchemy-compatible URL works (managed Postgres, local Docker Compose db, sqlite).
# Leave empty to disable logging entirely — inference works without it.
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Native processes: python3 scripts/api_key.py run -- uvicorn api.main:app
# API_KEY_FILE is the runtime file path; API_KEY_REQUIRED=true forbids missing keys.
# Legacy API_KEY remains supported for externally injected secrets (e.g. Kubernetes).
# Do not save an API_KEY value in this file or in a project .env.

# Optional: point the pipeline at a different dataset config.
# TRENDPILOT_CONFIG=config/dataset.yaml

# Optional host-port overrides (defaults are uncommon on purpose, to avoid
# clashing with other local services on 3000/8000/8080/8501/5432).
# API_PORT=9173
# DASHBOARD_PORT=9174
# POSTGRES_PORT=9175

# Optional training overrides (picked up by src/modeling/train.py)
# EPOCHS=100
# BATCH_SIZE=32
# LEARNING_RATE=0.001

# Optional KerasTuner overrides (picked up by src/modeling/tuning.py)
# TUNER_MAX_TRIALS=8
# TUNER_EPOCHS=40
